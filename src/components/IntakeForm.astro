---
import { departments, employees, toolCategories } from '../data/meridian-dynamics';
---

<form id="intake-form" class="intake-form">
	<div class="field">
		<label for="requesterId">Requester</label>
		<select id="requesterId" name="requesterId" required>
			{employees.map((e) => <option value={e.id}>{e.name} ({e.department})</option>)}
		</select>
	</div>

	<div class="field">
		<label for="department">Department this affects</label>
		<select id="department" name="department" required>
			{departments.map((d) => <option value={d}>{d}</option>)}
		</select>
	</div>

	<div class="field">
		<label for="description">What do you want, in plain language?</label>
		<textarea
			id="description"
			name="description"
			required
			rows="3"
			placeholder="e.g. a tool that flags expense reports missing a receipt"
		/>
	</div>

	<div class="field">
		<label for="category">Closest category</label>
		<select id="category" name="category" required>
			{toolCategories.map((c) => <option value={c}>{c}</option>)}
		</select>
	</div>

	<fieldset class="risk-fields">
		<legend>Risk signals</legend>

		<div class="field">
			<label for="pii">Personal/employee data exposure</label>
			<select id="pii" name="pii" required>
				<option value="none">None</option>
				<option value="some">Some</option>
				<option value="extensive">Extensive</option>
			</select>
		</div>

		<div class="field">
			<label for="financial">Financial system access</label>
			<select id="financial" name="financial" required>
				<option value="none">None</option>
				<option value="read-only">Read-only</option>
				<option value="read-write">Read-write</option>
			</select>
		</div>

		<div class="field">
			<label for="integrations">Number of systems it integrates with</label>
			<select id="integrations" name="integrations" required>
				<option value="none">0</option>
				<option value="one-or-two">1-2</option>
				<option value="three-plus">3+</option>
			</select>
		</div>
	</fieldset>

	<div class="actions">
		<button type="submit">Submit request</button>
		<button type="button" id="fill-example" class="secondary">Fill in an example</button>
	</div>
	<p id="form-error" class="form-error" hidden></p>
</form>

<section id="results" class="results" hidden aria-live="polite">
	<h2>Intake result</h2>
	<div id="results-body"></div>
</section>

<style>
	.intake-form {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		max-width: 34rem;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	label {
		font-size: var(--text-sm);
		font-weight: 600;
	}

	select,
	textarea {
		font: inherit;
		padding: var(--space-2);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-bg);
		color: var(--color-text);
	}

	.risk-fields {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: var(--space-3);
	}

	.risk-fields legend {
		font-size: var(--text-sm);
		font-weight: 600;
		padding-inline: var(--space-1);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	button {
		font: inherit;
		font-weight: 600;
		padding: var(--space-2) var(--space-4);
		border: 1px solid var(--color-accent);
		border-radius: var(--radius);
		background: var(--color-accent);
		color: var(--color-accent-contrast);
		cursor: pointer;
	}

	button.secondary {
		background: none;
		color: var(--color-accent);
	}

	button:disabled {
		opacity: 0.6;
		cursor: default;
	}

	.form-error {
		color: #b91c1c;
		font-size: var(--text-sm);
	}

	.results {
		margin-top: var(--space-5);
		padding: var(--space-4);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-bg-subtle);
	}

	.results h2 {
		margin-top: 0;
	}

	/* Results are rendered by the client script, so these rules reach into
	   innerHTML with :global. */
	.results :global(.decision) {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
		gap: var(--space-3);
	}

	.results :global(.decision-label) {
		display: block;
		font-size: var(--text-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		color: var(--color-text-muted);
		margin-bottom: var(--space-1);
	}

	.results :global(.decision ul) {
		margin: 0;
		padding-left: 1.1rem;
		font-size: var(--text-sm);
	}

	.results :global(.decision p) {
		margin: 0;
		font-size: var(--text-sm);
	}

	.results :global(.risk-pill) {
		display: inline-block;
		font-size: var(--text-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		padding: 0.1rem 0.55rem;
		border: 1px solid currentColor;
		border-radius: 999px;
		margin-right: var(--space-1);
	}

	/* Same colors as RiskBadge, so the result matches the log's risk column. */
	.results :global(.risk-pill--low) {
		color: #15803d;
	}

	.results :global(.risk-pill--medium) {
		color: #b45309;
	}

	.results :global(.risk-pill--high) {
		color: #b91c1c;
	}

	.results :global(.preview-heading) {
		font-size: var(--text-base);
		margin: var(--space-5) 0 var(--space-1);
	}

	.results :global(.preview-note) {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		margin: 0 0 var(--space-3);
	}

	.results :global(.preview-grid) {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
		gap: var(--space-3);
		align-items: start;
	}

	.results :global(.preview-card) {
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: var(--space-3);
		font-size: var(--text-sm);
		min-width: 0;
	}

	.results :global(.preview-card__kind) {
		display: block;
		font-size: var(--text-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		color: var(--color-text-muted);
		margin-bottom: var(--space-2);
	}

	/* Jira ticket */
	.results :global(.jira-top) {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		color: var(--color-text-muted);
		font-size: var(--text-xs);
	}

	.results :global(.jira-type) {
		width: 0.9rem;
		height: 0.9rem;
		border-radius: 3px;
		background: var(--chart-series-1);
		flex-shrink: 0;
	}

	.results :global(.jira-summary) {
		font-size: var(--text-base);
		margin: var(--space-1) 0 var(--space-2);
		overflow-wrap: anywhere;
	}

	.results :global(.chip) {
		display: inline-block;
		font-size: var(--text-xs);
		padding: 0.05rem 0.45rem;
		border-radius: 3px;
		background: var(--color-bg-subtle);
		border: 1px solid var(--color-border);
		margin: 0 0.25rem 0.25rem 0;
	}

	.results :global(.jira-desc) {
		border-top: 1px solid var(--color-border);
		margin-top: var(--space-2);
		padding-top: var(--space-2);
	}

	.results :global(.jira-desc p) {
		margin: 0 0 0.2rem;
		overflow-wrap: anywhere;
	}

	/* Slack message */
	.results :global(.slack-channel) {
		font-weight: 600;
		margin: 0 0 var(--space-2);
	}

	.results :global(.slack-msg) {
		display: flex;
		gap: var(--space-2);
	}

	.results :global(.slack-avatar) {
		width: 2.2rem;
		height: 2.2rem;
		border-radius: 6px;
		background: var(--color-accent);
		color: var(--color-accent-contrast);
		display: grid;
		place-items: center;
		font-size: var(--text-xs);
		font-weight: 700;
		flex-shrink: 0;
	}

	.results :global(.slack-meta) {
		margin: 0;
	}

	.results :global(.app-tag) {
		font-size: 0.65rem;
		font-weight: 700;
		padding: 0 0.3rem;
		border-radius: 3px;
		background: var(--color-bg-subtle);
		border: 1px solid var(--color-border);
		color: var(--color-text-muted);
		vertical-align: middle;
	}

	.results :global(.slack-time) {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
	}

	.results :global(.slack-text p) {
		margin: 0.15rem 0 0;
		overflow-wrap: anywhere;
	}

	.results :global(.slack-link) {
		color: var(--color-accent);
	}
</style>

<script>
	import { toLogRow } from '../lib/format-log-row';

	interface Duplicate {
		name: string;
		description: string;
	}

	interface IntakeResponse {
		duplicates: Duplicate[];
		risk: { score: number; band: 'Low' | 'Medium' | 'High' };
		routedTeam: { id: string; name: string };
		requesterName: string;
		jiraIssueKey: string;
		jiraUrl: string;
		jiraDraft: { projectKey: string; issueType: string; summary: string; labels: string[]; descriptionLines: string[] };
		slackText: string;
		stubbed: boolean;
	}

	// Highest possible score from risk-score.ts's weights (3 + 3 + 2).
	const MAX_RISK_SCORE = 8;

	const form = document.querySelector<HTMLFormElement>('#intake-form')!;
	const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
	const fillExample = document.querySelector<HTMLButtonElement>('#fill-example')!;
	const errorEl = document.querySelector<HTMLParagraphElement>('#form-error')!;
	const resultsSection = document.querySelector<HTMLElement>('#results')!;
	const resultsBody = document.querySelector<HTMLElement>('#results-body')!;
	const logBody = document.querySelector<HTMLTableSectionElement>('#log-body')!;

	const escapeHtml = (value: string) =>
		value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

	/** Renders Slack mrkdwn (*bold*, <url|label>) the way Slack would, from the exact text the app sends. */
	function renderSlackText(text: string) {
		return text
			.split('\n')
			.map((line) => {
				const html = escapeHtml(line)
					.replace(/&lt;([^|&]+)\|([^&]+)&gt;/g, '<span class="slack-link">$2</span>')
					.replace(/\*([^*]+)\*/g, '<strong>$1</strong>');
				return `<p>${html}</p>`;
			})
			.join('');
	}

	function renderResults(data: IntakeResponse) {
		const duplicatesHtml = data.duplicates.length
			? `<ul>${data.duplicates.map((d) => `<li><strong>${escapeHtml(d.name)}</strong>: ${escapeHtml(d.description)}</li>`).join('')}</ul>`
			: '<p>No close matches in the catalog.</p>';

		const band = data.risk.band;
		const draft = data.jiraDraft;
		const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

		const previewIntro = data.stubbed
			? `<h3 class="preview-heading">What production would create</h3>
				<p class="preview-note">Simulated preview. Jira and Slack aren't connected in this demo, so nothing was sent. These are the exact ticket and message the app builds for this request.</p>`
			: `<h3 class="preview-heading">Created in Jira and Slack</h3>
				<p class="preview-note"><a href="${escapeHtml(data.jiraUrl)}" target="_blank" rel="noreferrer">Open ${escapeHtml(data.jiraIssueKey)} in Jira</a></p>`;

		resultsBody.innerHTML = `
			<div class="decision">
				<div>
					<span class="decision-label">Duplicate check</span>
					${duplicatesHtml}
				</div>
				<div>
					<span class="decision-label">Risk</span>
					<p><span class="risk-pill risk-pill--${band.toLowerCase()}">${band}</span>score ${data.risk.score} of ${MAX_RISK_SCORE}</p>
				</div>
				<div>
					<span class="decision-label">Routed to</span>
					<p>${escapeHtml(data.routedTeam.name)}</p>
				</div>
			</div>

			${previewIntro}

			<div class="preview-grid">
				<article class="preview-card" aria-label="Jira ticket preview">
					<span class="preview-card__kind">Jira ticket</span>
					<div class="jira-top">
						<span class="jira-type" aria-hidden="true"></span>
						<span>${escapeHtml(data.jiraIssueKey)}</span>
						<span>&middot; ${escapeHtml(draft.issueType)} in ${escapeHtml(draft.projectKey)}</span>
					</div>
					<h4 class="jira-summary">${escapeHtml(draft.summary)}</h4>
					<div>${draft.labels.map((l) => `<span class="chip">${escapeHtml(l)}</span>`).join('')}</div>
					<div class="jira-desc">
						${draft.descriptionLines.map((line) => `<p>${escapeHtml(line)}</p>`).join('')}
					</div>
				</article>

				<article class="preview-card" aria-label="Slack message preview">
					<span class="preview-card__kind">Slack message</span>
					<p class="slack-channel"># ai-intake</p>
					<div class="slack-msg">
						<span class="slack-avatar" aria-hidden="true">IA</span>
						<div>
							<p class="slack-meta"><strong>Intake Agent</strong> <span class="app-tag">APP</span> <span class="slack-time">${time}</span></p>
							<div class="slack-text">${renderSlackText(data.slackText)}</div>
						</div>
					</div>
				</article>
			</div>
		`;
		resultsSection.hidden = false;
	}

	// One click to a request that trips the duplicate check (ExpenseEcho already does this).
	fillExample.addEventListener('click', () => {
		const set = (name: string, value: string) => {
			const field = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
			field.value = value;
		};
		set('requesterId', 'james-oconnell');
		set('department', 'Finance');
		set('description', 'A tool that flags expense reports missing a receipt');
		set('category', 'automation');
		set('pii', 'some');
		set('financial', 'read-only');
		set('integrations', 'one-or-two');
		form.querySelector<HTMLTextAreaElement>('#description')!.focus();
	});

	form.addEventListener('submit', async (event) => {
		event.preventDefault();
		errorEl.hidden = true;
		submitButton.disabled = true;
		submitButton.textContent = 'Submitting…';

		const formData = new FormData(form);
		const payload = Object.fromEntries(formData.entries());

		try {
			const response = await fetch('/api/intake', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(payload),
			});

			if (!response.ok) throw new Error(`Request failed (${response.status})`);

			const data = (await response.json()) as IntakeResponse;
			renderResults(data);

			const row = toLogRow({
				id: `session-${Date.now()}`,
				date: new Date().toLocaleDateString('en-CA'), // local YYYY-MM-DD
				requesterId: String(payload.requesterId),
				department: payload.department as any,
				description: String(payload.description),
				riskBand: data.risk.band,
				routedTeamId: data.routedTeam.id,
				jiraIssueKey: data.jiraIssueKey,
				jiraUrl: data.jiraUrl,
			});

			const tr = document.createElement('tr');
			tr.dataset.id = row.id;
			tr.innerHTML = `
				<td>${row.date}</td>
				<td>${escapeHtml(row.requesterName)}</td>
				<td>${escapeHtml(row.description)}</td>
				<td>${row.riskBand}</td>
				<td>${escapeHtml(row.routedTeamName)}</td>
				<td>${
					row.jiraUrl?.startsWith('http')
						? `<a href="${escapeHtml(row.jiraUrl)}" target="_blank" rel="noreferrer">${escapeHtml(row.jiraIssueKey)}</a>`
						: escapeHtml(row.jiraIssueKey)
				}</td>
			`;
			logBody.prepend(tr);

			form.reset();
			resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
		} catch (err) {
			errorEl.textContent = err instanceof Error ? err.message : 'Something went wrong.';
			errorEl.hidden = false;
		} finally {
			submitButton.disabled = false;
			submitButton.textContent = 'Submit request';
		}
	});
</script>
